{
  "name": "portfolio-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=12.0.2 <13"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "npm run validate:env:production && next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "vercel-build": "dotenvx run --env-file=.env.production -- npm run validate:env:production && dotenvx run --env-file=.env.production -- next build",
    "type-check": "tsc --noEmit",
    "validate:env": "tsx scripts/validate-env.ts --mode=development",
    "validate:env:production": "tsx scripts/validate-env.ts --mode=production",
    "validate:env:production:encrypted": "dotenvx run --env-file=.env.production -- npm run validate:env:production",
    "sync:env:production": "tsx scripts/sync-production-env.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit:dependencies": "npm audit --audit-level=high && npm audit --omit=dev --audit-level=moderate",
    "analyze": "ANALYZE=true next build",
    "build:encrypted": "dotenvx run --env-file=.env.production -- npm run build",
    "e2e": "npm run build && playwright test",
    "e2e:dev": "PLAYWRIGHT_USE_DEV_SERVER=1 playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "pre-commit": "npm run lint && npm run type-check && npm run validate:env && npm run test:run"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@next/env": "^16.3.4",
    "@next/third-parties": "^16.3.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.4",
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.44.0",
    "next": "^16.3.4",
    "nodemailer": "^10.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.87.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@dotenvx/dotenvx": "^2.23.0",
    "@eslint/eslintrc": "^3.3.7",
    "@next/bundle-analyzer": "^16.3.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "fsevents": false
  },
  "overrides": {
    "postcss": "8.5.28",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "flat-cache": {
      "flatted": "3.4.2"
    },
    "webpack-bundle-analyzer": {
      "ws": "7.5.12"
    }
  }
}
